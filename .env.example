# SepsisGuard Environment Configuration
# Copy this file to .env and fill in your actual values

# ========== DATABASE ==========
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/sepsisguard?retryWrites=true&w=majority

# ========== AI/ML ==========
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# ========== AUTHENTICATION ==========
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# GitHub OAuth
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET

# ========== NOTIFICATIONS ==========
# Twilio (SMS)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+12025551234

# SendGrid (Email)
SENDGRID_API_KEY=SG_YOUR_SENDGRID_API_KEY

# ========== APPLICATION ==========
callback_URL=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:3000

# ========== DEPLOYMENT ==========
ENVIRONMENT=development  # or production
DEBUG=True
